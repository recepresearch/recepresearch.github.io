```{=html}
<%
// Araştırmacılar: tek liste, data/ekip.yml'deki sırayla (içerik panelinden düzenlenir: /admin/ → araştırmacılar).
// Kart: fotoğraf, ad, varsa unvan; altında bağlantılar.
// template-params: dil (tr | en) · onek: sayfadan site köküne göreli yol (foto yolları "assets/…" biçiminde saklanır)
const p = (typeof templateParams !== "undefined" && templateParams) || {};
const en = p.dil === "en";
const onek = p.onek || "../";
const bekliyor = en ? "content in preparation." : "içerik hazırlanıyor.";
const basHarf = (ad) => ad.replace(/(Prof\.|Doç\.|Dr\.|Öğr\.|Üyesi|Araş\.|Arş\.|Gör\.)/g, "").trim().split(/\s+/).map(s => s[0]).slice(0, 2).join("");
const fotoYolu = (f) => /^(https?:)?\//.test(f) ? f : onek + f;
const baglantilar = [
  ["linkedin", "LinkedIn"], ["avesis", "AVESİS"], ["scholar", "Google Scholar"], ["orcid", "ORCID"], ["web", "web"]
];
%>
<% if (!items.length) { %><div class="recep-bekliyor"><%= bekliyor %></div><% } else { %>
<div class="recep-people">
<% for (const k of items) { const unvan = (en && k.unvan_en) || k.unvan; %>
<article class="recep-person">
<% if (k.foto) { %><img class="recep-avatar" src="<%- fotoYolu(k.foto) %>" alt="<%= k.ad %>" loading="lazy" width="120" height="120"><% } else { %><div class="recep-avatar" aria-hidden="true"><%= basHarf(k.ad) %></div><% } %>
<div class="recep-person-name"><%= k.ad %></div>
<% if (unvan) { %><div class="recep-person-role"><%= unvan %></div><% } %>
<div class="recep-person-links">
<% for (const [alan, etiket] of baglantilar) { if (!k[alan]) continue; const href = alan === "orcid" && !/^https?:/.test(k[alan]) ? "https://orcid.org/" + k[alan] : k[alan]; %>
<a href="<%- href %>" aria-label="<%= k.ad %> · <%= etiket %>"><%= etiket %></a>
<% } %>
<% if (k.eposta) { %><a href="mailto:<%- k.eposta %>" aria-label="<%= k.ad %> · <%= en ? "e-mail" : "e-posta" %>"><%= en ? "e-mail" : "e-posta" %></a><% } %>
</div>
</article>
<% } %>
</div>
<% } %>
```
